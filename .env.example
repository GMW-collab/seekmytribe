# Copy to .env (never commit .env). All values are read by src/server.ts.

# "preview" shows editorial flags and draft programmes; "production" hides drafts
# and refuses to build while launch-critical facts are unverified.
SITE_MODE=preview

# Public address of the site, used for canonical URLs, sitemap and social previews.
SITE_URL=https://seekmytribe.com

# Port for the Node server.
PORT=8080

# Long random string used to sign form timestamps (spam protection).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_SECRET=

# Email delivery for form submissions, via Resend (https://resend.com).
# Leave blank and the forms will answer "not set up yet" instead of pretending to send.
RESEND_API_KEY=
FORM_FROM_EMAIL=Seek My Tribe website <website@seekmytribe.com>
FORM_TO_EMAIL=

# "google" loads fonts from Google Fonts (used for quick previews only).
# Leave blank to use the self-hosted fonts in public/fonts (run: npm run fonts).
FONT_SOURCE=
