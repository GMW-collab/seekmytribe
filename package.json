{
  "name": "seekmytribe-site",
  "version": "0.1.0",
  "private": true,
  "description": "Website for Seek My Tribe CIC: real-world activities that help people meet, do things together and learn from one another.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node src/build.ts",
    "build:preview": "SITE_MODE=preview node src/build.ts",
    "build:production": "SITE_MODE=production node src/build.ts",
    "start": "node src/server.ts",
    "dev": "SITE_MODE=preview node src/build.ts && node --watch-path=src --watch-path=content src/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:browser": "python3 scripts/browser_checks.py",
    "check": "npm run typecheck && npm test && npm run build:preview",
    "fonts": "sh scripts/fetch-fonts.sh"
  },
  "dependencies": {
    "js-yaml": ">=3.14.0 <5",
    "marked": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
